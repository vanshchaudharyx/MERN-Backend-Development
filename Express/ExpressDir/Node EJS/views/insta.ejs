<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        img{
            height: 600px;
            width: 600px;
        }
    </style>
</head>

<body>
    <h2>This page belongs to @<%=data.name%>
    </h2>
    <button>Follow</button>
    <button>Message</button>
    <p>Followers:<%=data.followers%>&nbsp; Following:<%=data.following%>
    </p>
    <hr />


    <%for(let post of data.posts){%>
        <img src="<%=post.image%>" alt="Some image"/>
        <p>Likes:<%=post.likes%> &nbsp; Comments:<%=post.comments%></p>
                <%}%>

</body>

</html>