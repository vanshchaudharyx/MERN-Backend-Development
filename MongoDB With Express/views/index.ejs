<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Whatsapp</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            padding: 20px;
        }

        h3 {
            text-align: center;
            margin-bottom: 25px;
        }

        .chat {
            background-color: white;
            width: 350px;
            margin: 15px auto;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }

        .chat p {
            margin: 8px 0;
        }

        .msg {
            background-color: #4d5ca7;
            padding: 10px;
            border-radius: 8px;
            margin: 10px 0;
        }

        form {
            text-align: center;
            margin-top: 20px;
        }

        button {
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 15px;
            background-color: rgb(169, 105, 105);
        }
    </style>
</head>

<body>
    <form method="GET" action="/chats/new"><button>New Chat</button></form>
    <br />
    <h3>All chats</h3>
    <% for (let chat of chats){%>
        <div class="chat">
            <p>From: <%=chat.from %>
            </p>
            <div class="msg">
                <p>Message:<%=chat.msg%>
                </p>
                <form method="GET" action="/chats/<%=chat._id%>/edit">
                    <button id="editbutton">Edit</button>

                </form>
                <form method="POST" action="/chats/<%=chat._id%>?_method=DELETE">
                    <button id="Deletebtn">Delete Button</button>
                </form>
            </div>
            <p>Recieved by <%=chat.to%>
            </p>
            <hr />
            <p>
                <%=chat.created_at.toString().split(" ")[4]%><br />
            </p>
             <p>
                <%=chat.created_at.toString().split(" ").slice(0,4).join(" ")%><br />
            </p>


        </div>
        <%}%>
</body>

</html>